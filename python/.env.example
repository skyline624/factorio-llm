# Copier en .env et adapter.
# RCON : doit correspondre aux flags de lancement de Factorio
# (--rcon-port / --rcon-password).
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=factoriollm

# LLM (OpenAI-compatible : Ollama / LM Studio / vLLM / OpenAI / custom).
# Utilise au module agents (pas pour le socle RCON).
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5