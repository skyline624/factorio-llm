# ===== Secrets / config locale (NE JAMAIS COMMITTER) =====
# python/.env contient OPENAI_API_KEY et le mot de passe RCON -> local uniquement.
# Le modele vide est python/.env.example (versionne).
python/.env

# ===== Python =====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# ===== Factorio runtime (artefacts de jeu, recrees au lancement) =====
# Saves + autosaves (recreees via `factorio --create saves/fl-dev.zip`).
saves/
# Write-data isole serveur / client (genere au runtime par Factorio).
server-data/
client-data/
# mods/ : contient la junction `factorio-llm -> mod/` (lien Windows) + mod-list/dat.
# Le code du mod vit dans mod/ (versionne) ; la junction est recreee par les .bat.
mods/
# Logs serveur / client.
logs/
*.log
# Locks Factorio.
*.lock

# ===== Configs generees par les .bat (recreees au lancement via :writeconfig) =====
server/config/config.ini
client/config/config.ini

# ===== OS / editeurs =====
# Artefact Git Bash sous Windows : `> nul` cree un vrai fichier au lieu de viser le
# peripherique null (utiliser `/dev/null` en bash). Nom reserve : `del`/`Remove-Item`
# ne peuvent pas le supprimer, seul `rm -- nul` (Git Bash) fonctionne.
nul
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp
# Reglages locaux de l'assistant CLI (permissions, agents) : propres au poste.
.claude/
# ===== Hermes Agent (le JOUEUR, conteneur jetable) =====
# Ce qui est VERSIONNE : SOUL.md (son identite), config.yaml (modele + serveur MCP),
# skills/ (ce qu'on lui enseigne et ce qu'il apprend). C'est ce qui rend le depot
# portable : reinstaller la machine = cloner + `docker compose up`.
#
# Ce qui reste LOCAL : les secrets, et l'etat d'execution qui se recree.
hermes/.env
hermes/sessions/
# Les skills FOURNIES avec l'image sont redeployees a chaque `hermes update` : les
# versionner ajoute 160 000 lignes de contenu tiers a notre historique sans rien rendre
# plus portable. Seules les NOTRES sont suivies (voir l'exception plus bas).
hermes/skills/
hermes/backups/
hermes/lazy-packages/
hermes/skins/
hermes/workspace/
hermes/home/
hermes/memories/
hermes/plans/
hermes/platforms/
hermes/cron/
hermes/hooks/
hermes/pairing/
hermes/pending/
hermes/logs/
hermes/*.db
hermes/*.db-*
hermes/.no-bundled-skills

# EXCEPTION : ce qu'on ecrit nous-memes pour apprendre a Hermes a jouer. C'est la seule
# partie de skills/ qui compte pour la portabilite du depot.
!hermes/skills/
hermes/skills/*
!hermes/skills/factorio/
# Caches d'execution recrees par Hermes a chaque demarrage (sondes de point de
# terminaison, schemas MCP, longueurs de contexte, empreinte du prompt de skills).
hermes/cache/
hermes/.skills_prompt_snapshot.json
hermes/context_length_cache.yaml
hermes/*.bak-*

# Etat d'execution du conteneur (base de menaces de 2,5 Mo, sessions, verrous) : recree
# a chaque lancement, sans valeur pour qui clone le depot. Commite par megarde en H41.
hermes/.local/
hermes/.cache/
hermes/.config/
python/tests/mcp_appels_tests.log
